[
  {{- range $index, $page := where site.RegularPages "Section" "posts" -}}
    {{- if $index -}},{{- end -}}
    {
      "title": {{ $page.Title | jsonify }},
      "url": {{ $page.RelPermalink | jsonify }},
      "summary": {{ ($page.Description | default $page.Params.summary | default $page.Summary | plainify) | jsonify }},
      "content": {{ $page.Plain | jsonify }},
      "topics": {{ $page.Params.topics | jsonify }},
      "date": {{ $page.Date.Format "Jan 2, 2006" | jsonify }}
    }
  {{- end -}}
]
